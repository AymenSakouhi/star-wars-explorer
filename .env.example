# Base URL for the Star Wars API.
#
# swapi.dev was unreachable when this was built (2026-08-05) — the connection
# failed outright rather than returning an error status. The assignment allows
# either host, so the app defaults to the py4e mirror below.
#
# Copy this file to `.env` only if you need to override the default.
VITE_SWAPI_BASE_URL=https://swapi.py4e.com/api
